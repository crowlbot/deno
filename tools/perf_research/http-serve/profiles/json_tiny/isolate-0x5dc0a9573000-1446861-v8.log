second.source = this.source;\n    second.length = this.length;\n    return second;\n  }\n\n  /**\n   * @returns {InnerBody}\n   */\n  createProxy() {\n    let proxyStreamOrStatic;\n    if (\n      ObjectPrototypeIsPrototypeOf(\n        ReadableStreamPrototype\x2C\n        this.streamOrStatic\x2C\n      )\n    ) {\n      proxyStreamOrStatic = createProxy(this.streamOrStatic);\n    } else {\n      proxyStreamOrStatic = { ...this.streamOrStatic };\n      this.streamOrStatic.consumed = true;\n    }\n    const proxy = new InnerBody(proxyStreamOrStatic);\n    proxy.source = this.source;\n    proxy.length = this.length;\n    return proxy;\n  }\n}\n\n/**\n * @param {any} prototype\n * @param {symbol} bodySymbol\n * @param {symbol} mimeTypeSymbol\n * @returns {void}\n */\nfunction mixinBody(prototype\x2C bodySymbol\x2C mimeTypeSymbol) {\n  async function consumeBody(object\x2C type) {\n    webidl.assertBranded(object\x2C prototype);\n\n    const body = object[bodySymbol] !== null\n      ? await object[bodySymbol].consume()\n      : new Uint8Array();\n\n    const mimeType = type === "Blob" || type === "FormData"\n      ? object[mimeTypeSymbol]\n      : null;\n    return packageData(body\x2C type\x2C mimeType);\n  }\n\n  /** @type {PropertyDescriptorMap} */\n  const mixin = {\n    body: {\n      __proto__: null\x2C\n      /**\n       * @returns {ReadableStream<Uint8Array> | null}\n       */\n      get() {\n        webidl.assertBranded(this\x2C prototype);\n        if (this[bodySymbol] === null) {\n          return null;\n        } else {\n          return this[bodySymbol].stream;\n        }\n      }\x2C\n      configurable: true\x2C\n      enumerable: true\x2C\n    }\x2C\n    bodyUsed: {\n      __proto__: null\x2C\n      /**\n       * @returns {boolean}\n       */\n      get() {\n        webidl.assertBranded(this\x2C prototype);\n        try {\n          if (this[bodySymbol] !== null) {\n            return this[bodySymbol].consumed();\n          }\n        } catch (_) {\n     