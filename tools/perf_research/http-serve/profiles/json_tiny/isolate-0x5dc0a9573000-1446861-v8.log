script-source,274,file:///home/agent-loop/.agent-loop/instances/agent-320/repo/tools/perf_research/http-serve/servers/json_tiny.js,// Tiny JSON server \u2014 the canonical "Deno.serve fast path" workload.\n// Each request: parse method+url from request line\x2C look up headers (none)\x2C\n// construct a small Response with a JSON body and a Content-Type header.\n// Profile to attribute JS-side cost to ext/http vs ext/fetch internals.\n\nconst PORT = Number(Deno.args[0] ?? 8401);\n\nDeno.serve({ port: PORT }\x2C () => {\n  return new Response(JSON.stringify({ ok: true\x2C ts: 1 })\x2C {\n    headers: { "content-type": "application/json" }\x2C\n  });\n});\n
