NumberParseInt(value\x2C 8);\n  }\n\n  validateInt32(value\x2C name\x2C 0\x2C 2 ** 32 - 1);\n  return value;\n}\n\n/** @type {(buffer: unknown\x2C name?: string) => asserts buffer is ArrayBufferView} */\nconst validateBuffer = hideStackFrames((buffer\x2C name = "buffer") => {\n  if (!isArrayBufferView(buffer)) {\n    throw new codes.ERR_INVALID_ARG_TYPE(\n      name\x2C\n      ["Buffer"\x2C "TypedArray"\x2C "DataView"]\x2C\n      buffer\x2C\n    );\n  }\n});\n\n/** @type {ValidateNumber} */\nconst validateInteger = hideStackFrames(\n  (\n    value\x2C\n    name\x2C\n    min = NumberMIN_SAFE_INTEGER\x2C\n    max = NumberMAX_SAFE_INTEGER\x2C\n  ) => {\n    if (typeof value !== "number") {\n      throw new codes.ERR_INVALID_ARG_TYPE(name\x2C "number"\x2C value);\n    }\n    if (!NumberIsInteger(value)) {\n      throw new codes.ERR_OUT_OF_RANGE(name\x2C "an integer"\x2C value);\n    }\n    if (value < min || value > max) {\n      throw new codes.ERR_OUT_OF_RANGE(name\x2C `>= ${min} && <= ${max}`\x2C value);\n    }\n  }\x2C\n);\n\n/**\n * @typedef {{\n *   allowArray?: boolean\x2C\n *   allowFunction?: boolean\x2C\n *   nullable?: boolean\x2C\n * }} ValidateObjectOptions\n */\n/** @typedef {(value: unknown\x2C name: string\x2C options?: ValidateObjectOptions) => asserts value is object} ValidateObject */\n/** @type {ValidateObject} */\nconst validateObject = hideStackFrames((value\x2C name\x2C options) => {\n  const useDefaultOptions = options == null;\n  const allowArray = useDefaultOptions ? false : options.allowArray;\n  const allowFunction = useDefaultOptions ? false : options.allowFunction;\n  const nullable = useDefaultOptions ? false : options.nullable;\n  if (\n    (!nullable && value === null) ||\n    (!allowArray && ArrayIsArray(value)) ||\n    (typeof value !== "object" && (\n      !allowFunction || typeof value !== "function"\n    ))\n  ) {\n    throw new codes.ERR_INVALID_ARG_TYPE(name\x2C "Object"\x2C value);\n  }\n});\n\n/** @type {ValidateNumber} */\nconst validateInt32 = hideStackFrames(\n  (value\x2C name\x2C min = -2147483648\x2C max = 2147483647) => {\n    // The defaults for min and max correspond to the limits of 32-bit integers.\n    if (!isInt32(value)) {\n      if (typeof value !== "number") {\n        throw new codes.ERR_INVALID_ARG_TYPE(name\x2C "number"\x2C value);\n      }\n\n      if (!NumberIsInteger(value)) {\n        throw new codes.ERR_OUT_OF_RANGE(name\x2C "an integer"\x2C value);\n      }\n\n      throw new codes.ERR_OUT_OF_RANGE(name\x2C `>= ${min} && <= ${max}`\x2C value);\n    }\n\n    if (value < min || value > max) {\n      throw new codes.ERR_OUT_OF_RANGE(name\x2C `>= ${min} && <= ${max}`\x2C value);\n    }\n  }\x2C\n);\n\n/**\n * @type {(value: unknown\x2C name: string\x2C positive?: boolean) => asserts value is number}\n */\nconst validateUint32 = hideStackFrames(\n  (value\x2C name\x2C positive) => {\n    if (!isUint32(value)) {\n      if (typeof value !== "number") {\n        throw new codes.ERR_INVALID_ARG_TYPE(name\x2C "number"\x2C value);\n      }\n      if (!NumberIsInteger(value)) {\n        throw new codes.ERR_OUT_OF_RANGE(name\x2C "an integer"\x2C value);\n      }\n      const min = positive ? 1 : 0;\n      // 2 ** 32 === 4294967296\n      throw new codes.ERR_OUT_OF_RANGE(\n        name\x2C\n        `>= ${min} && < 4294967296`\x2C\n        value\x2C\n      );\n    }\n    if (positive && value === 0) {\n      throw new codes.ERR_OUT_OF_RANGE(name\x2C ">= 1 && < 4294967296"\x2C value);\n    }\n  }\x2C\n);\n\n/**\n * @param {unknown} value\n * @param {string} name\n */\nfunction validateString(value\x2C name) {\n  if (typeof value !== "string") {\n    throw new codes.ERR_INVALID_ARG_TYPE(name\x2C "string"\x2C value);\n  }\n}\n\n/** @typedef {(value: unknown\x2C name: string\x2C min?: number\x2C max?: number) => asserts value is number} ValidateNumber */\n/** @type {ValidateNumber} */\nconst validateNumber = hideStackFrames((value\x2C name\x2C min = undefined\x2C max) => {\n  if (typ