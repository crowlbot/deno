: core.decode(chunk);\n}\n\nclass InnerBody {\n  /**\n   * @param {ReadableStream<Uint8Array> | { body: Uint8Array | string\x2C consumed: boolean }} stream\n   */\n  constructor(stream) {\n    /** @type {ReadableStream<Uint8Array> | { body: Uint8Array | string\x2C consumed: boolean }} */\n    this.streamOrStatic = stream ??\n      { body: new Uint8Array()\x2C consumed: false };\n    /** @type {null | Uint8Array | string | Blob | FormData} */\n    this.source = null;\n    /** @type {null | number} */\n    this.length = null;\n  }\n\n  get stream() {\n    if (\n      !ObjectPrototypeIsPrototypeOf(\n        ReadableStreamPrototype\x2C\n        this.streamOrStatic\x2C\n      )\n    ) {\n      const { body\x2C consumed } = this.streamOrStatic;\n      if (consumed) {\n        this.streamOrStatic = new ReadableStream();\n        this.streamOrStatic.getReader();\n        readableStreamDisturb(this.streamOrStatic);\n        readableStreamClose(this.streamOrStatic);\n      } else {\n        this.streamOrStatic = new ReadableStream({\n          start(controller) {\n            controller.enqueue(chunkToU8(body));\n            controller.close();\n          }\x2C\n        });\n      }\n    }\n    return this.streamOrStatic;\n  }\n\n  /**\n   * https://fetch.spec.whatwg.org/#body-unusable\n   * @returns {boolean}\n   */\n  unusable() {\n    if (\n      ObjectPrototypeIsPrototypeOf(\n        ReadableStreamPrototype\x2C\n        this.streamOrStatic\x2C\n      )\n    ) {\n      return this.streamOrStatic.locked ||\n        isReadableStreamDisturbed(this.streamOrStatic);\n    }\n    return this.streamOrStatic.consumed;\n  }\n\n  /**\n   * @returns {boolean}\n   */\n  consumed() {\n    if (\n      ObjectPrototypeIsPrototypeOf(\n        ReadableStreamPrototype\x2C\n        this.streamOrStatic\x2C\n      )\n    ) {\n      return isReadableStreamDisturbed(this.streamOrStatic);\n    }\n    return this.streamOrStatic.consumed;\n  }\n\n  /**\n   * https://fetch.spec.whatwg.org/#concept-bod